---
import { About } from "../icons/About";
import { IconHome } from "../icons/IconHome";
import { FaceDolor } from "../icons/FaceDolor";
import { IconAgitacion } from "../icons/IconAgitacion";
import { IconDelirium } from "../icons/IconDelirium";

// src/components/Sidebar.astro
---

<aside class="w-80 bg-blue-700/85 text-white min-h-screen p-4 flex flex-col">
  <div class="mb-8">
    <h1 class="text-xl font-bold text-center mt-10">
      Sistema de Evaluación de SedoAnalegesia
    </h1>
  </div>

  <nav class="flex-1 mt-8 pt-4 border-t border-blue-700">
    <ul class="space-y-2">
      <li>
        <a
          href="/about"
          class="flex items-center p-2 rounded hover:bg-blue-700"
        >
          <About />
          <span>Acerca del Proyecto</span>
        </a>
      </li>

      <li>
        <a href="/" class="flex items-center p-2 rounded hover:bg-blue-700">
          <IconHome />
          <span>Inicio</span>
        </a>
      </li>

      <li>
        <a
          href="/dolor"
          class="flex items-center p-2 rounded hover:bg-blue-700 bg-blue-900"
        >
          <FaceDolor />
          <span>Escala de Dolor</span>
        </a>
      </li>

      <li>
        <a href="#" class="flex items-center p-2 rounded hover:bg-blue-700">
          <IconAgitacion />
          <span>Escala de Sedación</span>
        </a>
      </li>

      <li>
        <a href="#" class="flex items-center p-2 rounded hover:bg-blue-700">
          <IconDelirium />
          <span>Escala de Delirium</span>
        </a>
      </li>

      <li>
        <a href="#" class="flex items-center p-2 rounded hover:bg-blue-700">
          <IconDelirium />
          <span>Escala de Abstinencia</span>
        </a>
      </li>
    </ul>
  </nav>
</aside>
