---
import { Linkedin } from "../icons/Linkedin";
import { Email } from "../icons/Email";
// src/components/Footer.astro
---

<footer class="bg-gray-800 text-white mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Información del Sistema -->
      <div class="col-span-1 md:col-span-2">
        <h3 class="text-lg font-semibold mb-4">
          Sistema de Evaluación del Dolor
        </h3>
        <p class="text-gray-300 mb-4 text-sm leading-relaxed">
          Plataforma especializada para la evaluación y seguimiento del dolor en
          pacientes críticos utilizando escalas validadas como BPS, RASS y
          CAM-ICU.
        </p>
        <div class="flex space-x-4">
          <a href="#" class="text-gray-400 hover:text-white transition-colors">
            <Linkedin />
          </a>
        </div>
      </div>

      <!-- Enlaces Rápidos -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Enlaces Rápidos</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="/"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              >Inicio</a
            >
          </li>
          <li>
            <a
              href="/"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              >Escala BPS</a
            >
          </li>
          <li>
            <a
              href="/about"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              >Sobre el Proyecto</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              >Bibliografía</a
            >
          </li>
          <li>
            <a
              href="#"
              class="text-gray-300 hover:text-white transition-colors text-sm"
              >Contacto</a
            >
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="text-lg font-semibold mb-4">Contacto</h3>
        <div class="space-y-2 text-sm text-gray-300">
          <div class="flex items-center gap-2">
            <Email />
            <span>investigacion@hospital.edu</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Separador -->
    <div class="border-t border-gray-700 mt-8 pt-8">
      <div class="flex flex-col md:flex-row justify-between items-center">
        <div class="text-gray-300 text-sm mb-4 md:mb-0">
          <p>
            &copy; 2025 | Creado y diseñado con mucho ❤️​ por Gabriel Agüero |
            Frontend Developer
          </p>
        </div>

        <div class="flex space-x-6 text-sm">
          <a href="#" class="text-gray-300 hover:text-white transition-colors"
            >Política de Privacidad</a
          >
          <a href="#" class="text-gray-300 hover:text-white transition-colors"
            >Términos de Uso</a
          >
          <a href="#" class="text-gray-300 hover:text-white transition-colors"
            >Aviso Legal</a
          >
        </div>
      </div>
    </div>

    <!-- Información Adicional -->
    <div class="mt-6 text-center">
      <p class="text-gray-400 text-xs">
        Este sistema está destinado exclusivamente para uso médico profesional.
        La información proporcionada no sustituye el criterio clínico.
      </p>
    </div>
  </div>
</footer>
