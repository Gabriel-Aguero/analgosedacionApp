---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="max-w-4xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-blue-700 mb-4">Sobre el Proyecto</h1>
      <p class="text-xl text-gray-600">
        Investigación en Evaluación del Dolor en Pacientes Críticos No
        Comunicativos
      </p>
    </div>

    <!-- Introducción -->
    <section class="mb-12">
      <div class="bg-white rounded-lg shadow-md p-8">
        <h2 class="text-2xl font-bold text-blue-700 mb-4">
          Proyecto de Investigación
        </h2>
        <p class="text-gray-700 mb-4 leading-relaxed">
          Este proyecto de investigación se enfoca en el desarrollo e
          implementación de herramientas validadas para la evaluación
          sistemática del dolor en pacientes críticos que no pueden comunicarse
          verbalmente, particularmente aquellos bajo ventilación mecánica en
          unidades de cuidados intensivos.
        </p>
        <p class="text-gray-700 leading-relaxed">
          La correcta identificación y tratamiento del dolor en estos pacientes
          es fundamental para mejorar su comfort, reducir complicaciones y
          optimizar los resultados clínicos.
        </p>
      </div>
    </section>

    <!-- Objetivos -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-blue-700 mb-6">
        Objetivos del Proyecto
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-center mb-4">
            <div
              class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"
                ></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold ml-4">Objetivo Principal</h3>
          </div>
          <p class="text-gray-600">
            Implementar y validar un sistema estandarizado de evaluación del
            dolor utilizando la Escala Conductual de Dolor (BPS) en pacientes
            críticos no comunicativos.
          </p>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="flex items-center mb-4">
            <div
              class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-green-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold ml-4">Objetivos Específicos</h3>
          </div>
          <ul class="text-gray-600 space-y-2">
            <li>• Capacitar al personal en el uso de escalas validadas</li>
            <li>• Reducir la subidentificación del dolor</li>
            <li>• Mejorar la adecuación de la analgesia</li>
            <li>• Evaluar impacto en outcomes clínicos</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Metodología -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-blue-700 mb-6">Metodología</h2>

      <div class="bg-white rounded-lg shadow-md p-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="text-center">
            <div
              class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-blue-600 font-bold text-xl">1</span>
            </div>
            <h3 class="text-lg font-semibold mb-2">Diseño del Estudio</h3>
            <p class="text-gray-600 text-sm">
              Estudio prospectivo observacional en UCI médico-quirúrgica
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-green-600 font-bold text-xl">2</span>
            </div>
            <h3 class="text-lg font-semibold mb-2">Población</h3>
            <p class="text-gray-600 text-sm">
              Pacientes adultos críticos no comunicativos bajo ventilación
              mecánica
            </p>
          </div>

          <div class="text-center">
            <div
              class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
            >
              <span class="text-purple-600 font-bold text-xl">3</span>
            </div>
            <h3 class="text-lg font-semibold mb-2">Evaluación</h3>
            <p class="text-gray-600 text-sm">
              Aplicación sistemática de BPS, RASS y CAM-ICU por personal
              entrenado
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Equipo -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-blue-700 mb-6">
        Equipo de Investigación
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div
            class="w-20 h-20 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-blue-600 font-bold text-xl">AR</span>
          </div>
          <h3 class="text-lg font-semibold">Dr. Alex Ramos</h3>
          <p class="text-gray-600 text-sm mb-2">Médico Intensivista</p>
          <p class="text-gray-500 text-xs">Investigador Principal</p>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div
            class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-green-600 font-bold text-xl">MG</span>
          </div>
          <h3 class="text-lg font-semibold">Dra. María González</h3>
          <p class="text-gray-600 text-sm mb-2">Epidemióloga</p>
          <p class="text-gray-500 text-xs">Co-investigadora</p>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div
            class="w-20 h-20 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <span class="text-purple-600 font-bold text-xl">CL</span>
          </div>
          <h3 class="text-lg font-semibold">Dr. Carlos López</h3>
          <p class="text-gray-600 text-sm mb-2">Anestesiólogo</p>
          <p class="text-gray-500 text-xs">Asesor Metodológico</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
