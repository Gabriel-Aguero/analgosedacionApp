---
import { Check } from "../icons/Check";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="max-w-6xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-blue-800 mb-4">
        Escalas de Evaluación del Dolor
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Seleccione la escala de dolor apropiada según las características del
        paciente
      </p>
    </div>

    <!-- Grid de Escalas -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8">
      <!-- FLACC -->
      <a
        href="/dolor/flacc"
        class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden group cursor-pointer"
      >
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div
              class="w-14 h-14 bg-purple-100 rounded-xl flex items-center justify-center group-hover:bg-purple-200 transition-colors"
            >
              <span class="text-purple-600 font-bold text-lg">FLACC</span>
            </div>
            <div class="ml-4">
              <h3 class="text-xl font-semibold text-gray-800">Escala FLACC</h3>
              <p class="text-sm text-gray-500">
                Face, Legs, Activity, Cry, Consolability
              </p>
            </div>
          </div>

          <p class="text-gray-600 mb-4 leading-relaxed">
            Escala conductual para evaluar dolor en niños pequeños o pacientes
            que no pueden comunicarse verbalmente.
          </p>

          <div class="mb-4">
            <h4 class="text-sm font-medium text-gray-700 mb-2">
              Parámetros evaluados:
            </h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li class="flex items-center gap-2">
                <Check />
                Expresión facial
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Movimiento de piernas
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Actividad corporal
              </li>
            </ul>
          </div>

          <div class="flex justify-between items-center">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800"
            >
              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-11a1 1 0 10-2 0v2H7a1 1 0 100 2h2v2a1 1 0 102 0v-2h2a1 1 0 100-2h-2V7z"
                  clip-rule="evenodd"></path>
              </svg>
              Puntuación: 0-10
            </span>
            <button
              class="text-purple-600 cursor-pointer hover:text-purple-800 font-medium flex items-center group-hover:translate-x-1 transition-transform"
            >
              Usar Escala
              <svg
                class="w-4 h-4 ml-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </a>

      <!-- OPS -->
      <a
        href="/dolor/ops"
        class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden group cursor-pointer"
        onclick="navigateToScale('ops')"
      >
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div
              class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center group-hover:bg-blue-200 transition-colors"
            >
              <span class="text-blue-600 font-bold text-lg">OPS</span>
            </div>
            <div class="ml-4">
              <h3 class="text-xl font-semibold text-gray-800">
                Objective Pain Scale (OPS)
              </h3>
              <p class="text-sm text-gray-500">Escala Objetiva del Dolor</p>
            </div>
          </div>

          <p class="text-gray-600 mb-4 leading-relaxed">
            Escala multidimensional que evalúa parámetros fisiológicos y
            conductuales para una valoración objetiva del dolor.
          </p>

          <div class="mb-4">
            <h4 class="text-sm font-medium text-gray-700 mb-2">
              Parámetros evaluados:
            </h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li class="flex items-center gap-2">
                <Check />
                Parámetros fisiológicos
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Comportamiento
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Respuesta al estímulo
              </li>
            </ul>
          </div>

          <div class="flex justify-between items-center">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800"
            >
              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              Validada en UCI
            </span>
            <button
              class="text-blue-600 cursor-pointer hover:text-blue-800 font-medium flex items-center group-hover:translate-x-1 transition-transform"
            >
              Usar Escala
              <svg
                class="w-4 h-4 ml-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </a>

      <!-- Escala Numérica -->
      <a
        href="/dolor/numerica"
        class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden group cursor-pointer"
        onclick="navigateToScale('numerica')"
      >
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div
              class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center group-hover:bg-green-200 transition-colors"
            >
              <span class="text-green-600 font-bold text-lg">0-10</span>
            </div>
            <div class="ml-4">
              <h3 class="text-xl font-semibold text-gray-800">
                Escala Numérica
              </h3>
              <p class="text-sm text-gray-500">Escala Verbal Numérica</p>
            </div>
          </div>

          <p class="text-gray-600 mb-4 leading-relaxed">
            Escala subjetiva donde el paciente auto-reporta su nivel de dolor
            usando números del 0 al 10.
          </p>

          <div class="mb-4">
            <h4 class="text-sm font-medium text-gray-700 mb-2">
              Características:
            </h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li class="flex items-center gap-2">
                <Check />
                Para pacientes comunicativos
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Auto-reporte directo
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Fácil de entender
              </li>
            </ul>
          </div>

          <div class="flex justify-between items-center">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-100 text-green-800"
            >
              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
              </svg>
              Rango: 0-10
            </span>
            <button
              class="text-green-600 cursor-pointer hover:text-green-800 font-medium flex items-center group-hover:translate-x-1 transition-transform"
            >
              Usar Escala
              <svg
                class="w-4 h-4 ml-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </a>

      <!-- Escala de Caritas -->
      <a
        href="/dolor/caritas"
        class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden group cursor-pointer"
        onclick="navigateToScale('caritas')"
      >
        <div class="p-6">
          <div class="flex items-center mb-4">
            <div
              class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center group-hover:bg-orange-200 transition-colors"
            >
              <span class="text-orange-600 font-bold text-lg">😊</span>
            </div>
            <div class="ml-4">
              <h3 class="text-xl font-semibold text-gray-800">
                Escala de Caritas
              </h3>
              <p class="text-sm text-gray-500">
                Escala de Expresiones Faciales
              </p>
            </div>
          </div>

          <p class="text-gray-600 mb-4 leading-relaxed">
            Escala visual con expresiones faciales que representan diferentes
            niveles de dolor, ideal para niños y adultos con dificultades de
            comunicación.
          </p>

          <div class="mb-4">
            <h4 class="text-sm font-medium text-gray-700 mb-2">
              Adecuada para:
            </h4>
            <ul class="text-sm text-gray-600 space-y-1">
              <li class="flex items-center gap-2">
                <Check />
                Pacientes pediátricos
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Dificultades cognitivas
              </li>
              <li class="flex items-center gap-2">
                <Check />
                Barreras lingüísticas
              </li>
            </ul>
          </div>

          <div class="flex justify-between items-center">
            <span
              class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-orange-100 text-orange-800"
            >
              <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z"
                  clip-rule="evenodd"></path>
              </svg>
              6 niveles
            </span>
            <button
              class="text-orange-600 cursor-pointer hover:text-orange-800 font-medium flex items-center group-hover:translate-x-1 transition-transform"
            >
              Usar Escala
              <svg
                class="w-4 h-4 ml-1"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path>
              </svg>
            </button>
          </div>
        </div>
      </a>
    </div>

    <!-- Información adicional -->
    <div class="mt-12 bg-blue-50 rounded-xl p-6">
      <h3 class="text-lg font-semibold text-blue-800 mb-3">
        ¿Cómo seleccionar la escala adecuada?
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm text-blue-700">
        <div class="flex items-start">
          <svg
            class="w-5 h-5 mt-0.5 mr-2"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
              clip-rule="evenodd"></path>
          </svg>
          <span
            >Use <strong>FLACC u OPS</strong> para pacientes no comunicativos o críticos</span
          >
        </div>
        <div class="flex items-start">
          <svg
            class="w-5 h-5 mt-0.5 mr-2 flex-shrink-0"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
              clip-rule="evenodd"></path>
          </svg>
          <span
            >Use <strong>Escala Numérica</strong> para pacientes adultos comunicativos</span
          >
        </div>
        <div class="flex items-start">
          <svg
            class="w-5 h-5 mt-0.5 mr-2 flex-shrink-0"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z"
              clip-rule="evenodd"></path>
          </svg>
          <span
            >Use <strong>Caritas</strong> para niños o pacientes con dificultades</span
          >
        </div>
      </div>
    </div>
  </div>
</Layout>
<script>
  function navigateToScale(scaleType) {
    // Aquí puedes implementar la navegación a la página específica de cada escala
    switch (scaleType) {
      case "flacc":
        window.location.href = "/escalas/flacc";
        break;
      case "ops":
        window.location.href = "/escalas/ops";
        break;
      case "numerica":
        window.location.href = "/escalas/numerica";
        break;
      case "caritas":
        window.location.href = "/escalas/caritas";
        break;
      default:
        console.log("Escala no reconocida");
    }
  }
</script>
