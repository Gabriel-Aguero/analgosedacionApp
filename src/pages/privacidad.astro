---
import Layout from '../layouts/Layout.astro'
---

<Layout>
  <div class='max-w-4xl mx-auto py-8 px-4'>
    <!-- Header -->
    <div class='text-center mb-12'>
      <h1 class='text-4xl font-bold text-green-800 mb-4'>
        Política de Privacidad
      </h1>
      <p class='text-xl text-gray-600'>
        Protección de datos y confidencialidad médica
      </p>
    </div>

    <!-- Contenido -->
    <div class='bg-white rounded-xl shadow-lg p-8'>
      <div class='prose prose-lg max-w-none'>
        <!-- Introducción -->
        <section class='mb-8'>
          <h2 class='text-2xl font-bold text-gray-800 mb-4'>1. Introducción</h2>
          <p class='text-gray-700 mb-4'>
            En <strong>Sistema de Evaluación de SedoAnalgesia</strong> nos comprometemos
            a proteger la privacidad y confidencialidad de los datos de los pacientes
            y usuarios del sistema, cumpliendo con el Reglamento General de Protección
            de Datos (RGPD) y la Ley Orgánica de Protección de Datos Personales y
            garantía de los derechos digitales (LOPDGDD).
          </p>
          <div class='bg-green-50 p-4 rounded-lg'>
            <p class='text-green-700 font-semibold'>
              🔒 Este sistema maneja datos de salud especialmente protegidos
              bajo la categoría máxima de protección.
            </p>
          </div>
        </section>

        <!-- Datos Recopilados -->
        <section class='mb-8'>
          <h2 class='text-2xl font-bold text-gray-800 mb-4'>
            2. Datos que Recopilamos
          </h2>
          <div class='space-y-6'>
            <div class='bg-blue-50 p-4 rounded-lg'>
              <h3 class='font-semibold text-blue-800 mb-3'>
                📋 Datos de Pacientes
              </h3>
              <div class='grid grid-cols-1 md:grid-cols-2 gap-4'>
                <div>
                  <h4 class='font-medium text-blue-700 mb-2'>
                    Datos Identificativos:
                  </h4>
                  <ul class='text-blue-600 text-sm space-y-1'>
                    <li>• Identificación médica única</li>
                    <li>• Edad y género</li>
                    <li>• Historial médico relevante</li>
                    <li>• Condición clínica actual</li>
                  </ul>
                </div>
                <div>
                  <h4 class='font-medium text-blue-700 mb-2'>
                    Datos de Salud:
                  </h4>
                  <ul class='text-blue-600 text-sm space-y-1'>
                    <li>• Evaluaciones de dolor</li>
                    <li>• Resultados de escalas</li>
                    <li>• Tratamientos aplicados</li>
                    <li>• Evolución clínica</li>
                  </ul>
                </div>
              </div>
            </div>

            <div class='bg-purple-50 p-4 rounded-lg'>
              <h3 class='font-semibold text-purple-800 mb-3'>
                👨‍⚕️ Datos de Profesionales
              </h3>
              <ul class='text-purple-700 space-y-1'>
                <li>• Identificación profesional</li>
                <li>• Credenciales de acceso</li>
                <li>• Especialidad médica</li>
                <li>• Centro de trabajo</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Finalidad del Tratamiento -->
        <section class='mb-8'>
          <h2 class='text-2xl font-bold text-gray-800 mb-4'>
            3. Finalidad del Tratamiento
          </h2>
          <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
            <div class='bg-green-50 p-4 rounded-lg'>
              <h3 class='font-semibold text-green-800 mb-2'>
                🎯 Finalidades Principales
              </h3>
              <ul class='text-green-700 space-y-2'>
                <li class='flex items-start'>
                  <span class='text-green-500 mr-2'>•</span>
                  Evaluación y seguimiento del dolor
                </li>
                <li class='flex items-start'>
                  <span class='text-green-500 mr-2'>•</span>
                  Documentación clínica
                </li>
                <li class='flex items-start'>
                  <span class='text-green-500 mr-2'>•</span>
                  Mejora de la calidad asistencial
                </li>
                <li class='flex items-start'>
                  <span class='text-green-500 mr-2'>•</span>
                  Investigación clínica anonimizada
                </li>
              </ul>
            </div>

            <div class='bg-yellow-50 p-4 rounded-lg'>
              <h3 class='font-semibold text-yellow-800 mb-2'>⚖️ Base Legal</h3>
              <ul class='text-yellow-700 space-y-2'>
                <li class='flex items-start'>
                  <span class='text-yellow-500 mr-2'>•</span>
                  Ejecución de contrato médico
                </li>
                <li class='flex items-start'>
                  <span class='text-yellow-500 mr-2'>•</span>
                  Interés vital del paciente
                </li>
                <li class='flex items-start'>
                  <span class='text-yellow-500 mr-2'>•</span>
                  Cumplimiento de obligaciones legales
                </li>
                <li class='flex items-start'>
                  <span class='text-yellow-500 mr-2'>•</span>
                  Interés público en salud
                </li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Medidas de Seguridad -->
        <section class='mb-8'>
          <h2 class='text-2xl font-bold text-gray-800 mb-4'>
            4. Medidas de Seguridad
          </h2>
          <div class='space-y-4'>
            <div class='bg-red-50 p-4 rounded-lg'>
              <h3 class='font-semibold text-red-800 mb-2'>
                🛡️ Protección Técnica
              </h3>
              <div class='grid grid-cols-1 md:grid-cols-3 gap-4 text-sm'>
                <div class='text-center'>
                  <div class='text-2xl mb-2'>🔐</div>
                  <p class='text-red-700'>
                    Cifrado de datos en tránsito y en reposo
                  </p>
                </div>
                <div class='text-center'>
                  <div class='text-2xl mb-2'>🚪</div>
                  <p class='text-red-700'>Autenticación multifactor</p>
                </div>
                <div class='text-center'>
                  <div class='text-2xl mb-2'>📊</div>
                  <p class='text-red-700'>Auditoría de accesos</p>
                </div>
              </div>
            </div>

            <div class='bg-blue-50 p-4 rounded-lg'>
              <h3 class='font-semibold text-blue-800 mb-2'>
                📝 Protección Organizativa
              </h3>
              <ul class='text-blue-700 space-y-2'>
                <li>• Acuerdos de confidencialidad con el personal</li>
                <li>• Formación específica en protección de datos</li>
                <li>• Procedimientos documentados de seguridad</li>
                <li>• Evaluaciones periódicas de riesgos</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Derechos ARCO -->
        <section class='mb-8'>
          <h2 class='text-2xl font-bold text-gray-800 mb-4'>
            5. Derechos de los Interesados
          </h2>
          <div class='bg-gray-50 p-6 rounded-lg'>
            <div class='grid grid-cols-1 md:grid-cols-2 gap-6'>
              <div>
                <h3 class='font-semibold text-gray-800 mb-3'>
                  📋 Derechos ARCO-POL
                </h3>
                <ul class='text-gray-700 space-y-2'>
                  <li>
                    <strong>Acceso:</strong> Conocer qué datos tenemos sobre usted
                  </li>
                  <li>
                    <strong>Rectificación:</strong> Modificar datos inexactos
                  </li>
                  <li>
                    <strong>Cancelación:</strong> Solicitar la eliminación de datos
                  </li>
                  <li><strong>Oposición:</strong> Oponerse al tratamiento</li>
                  <li>
                    <strong>Portabilidad:</strong> Recibir sus datos en formato estructurado
                  </li>
                  <li>
                    <strong>Limitación:</strong> Limitar el tratamiento en ciertos
                    casos
                  </li>
                </ul>
              </div>

              <div>
                <h3 class='font-semibold text-gray-800 mb-3'>
                  📞 Ejercicio de Derechos
                </h3>
                <div class='bg-white p-4 rounded border'>
                  <p class='text-gray-600 text-sm mb-2'>
                    Para ejercer sus derechos, contacte con nuestro Delegado de
                    Protección de Datos:
                  </p>
                  <ul class='text-gray-700 text-sm space-y-1'>
                    <li>📧 Email: dpo@sedoanalgesia-sistema.com</li>
                    <li>📞 Teléfono: +34 900 123 456</li>
                    <li>📮 Dirección: [Dirección del DPO]</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Conservación de Datos -->
        <section class='mb-8'>
          <h2 class='text-2xl font-bold text-gray-800 mb-4'>
            6. Conservación de Datos
          </h2>
          <div class='bg-yellow-50 p-4 rounded-lg'>
            <p class='text-yellow-700'>
              Los datos de salud se conservarán durante el tiempo necesario para
              cumplir con las finalidades del tratamiento y los plazos legales
              establecidos en la legislación sanitaria (mínimo 5 años desde el
              último tratamiento, pudiendo extenderse hasta 15-20 años según la
              comunidad autónoma).
            </p>
          </div>
        </section>

        <!-- Información de Contacto -->
        <section class='bg-green-50 p-6 rounded-lg'>
          <h2 class='text-xl font-bold text-green-800 mb-3'>
            📞 Contacto y Dudas
          </h2>
          <p class='text-green-700 mb-3'>
            Para cualquier pregunta sobre esta política de privacidad o el
            tratamiento de sus datos, puede contactarnos a través de:
          </p>
          <div class='grid grid-cols-1 md:grid-cols-2 gap-4 text-sm'>
            <div>
              <h3 class='font-semibold text-green-800 mb-2'>
                Delegado de Protección de Datos:
              </h3>
              <p class='text-green-600'>dpo@sedoanalgesia-sistema.com</p>
            </div>
            <div>
              <h3 class='font-semibold text-green-800 mb-2'>
                Atención al Usuario:
              </h3>
              <p class='text-green-600'>privacidad@sedoanalgesia-sistema.com</p>
            </div>
          </div>
          <p class='text-green-600 text-sm mt-3'>
            <strong>Última actualización:</strong>
            {
              new Date().toLocaleDateString('es-ES', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })
            }
          </p>
        </section>
      </div>
    </div>
  </div>
</Layout>
