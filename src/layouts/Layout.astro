---
import FlechaScrollTop from '../components/FlechaScrollTop'
import Footer from '../components/Footer.astro'
import Sidebar from '../components/Sidebar'
import '../styles/global.css'
---

<!doctype html>
<html lang='es'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>Escalas de SedoAnalegesia</title>
  </head>
  <body class='bg-gray-100'>
    <div class='flex-col md:flex md:flex-row min-h-screen'>
      <Sidebar client:load />
      <main class='flex-1 p-8'>
        <slot />
      </main>
    </div>
    <FlechaScrollTop client:load />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
