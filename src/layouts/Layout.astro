---
import FlechaScrollTop from "../components/FlechaScrollTop";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->

    <meta name="generator" content={Astro.generator} />
    <title>Escalas de SedoAnalegesia</title>
  </head>
  <body class="bg-white">
    <div class="flex-col md:flex md:flex-row min-h-screen">
      <Sidebar client:load />
      <main class="flex-1 p-8 z-20">
        <slot />
      </main>
    </div>
    <FlechaScrollTop client:load />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;

    background: white;
    background-image: linear-gradient(
        to right,
        rgba(71, 85, 105, 0.3) 1px,
        transparent 1px
      ),
      linear-gradient(to bottom, rgba(71, 85, 105, 0.3) 1px, transparent 1px),
      radial-gradient(
        circle at 50% 50%,
        rgba(139, 92, 246, 0.25) 0%,
        rgba(139, 92, 246, 0.1) 40%,
        transparent 80%
      );
    background-size:
      32px 32px,
      32px 32px,
      100% 100%;
    background-attachment: fixed; /* Esto hace que el fondo sea fijo al hacer scroll */
  }
</style>
